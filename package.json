{
  "name": "openvault",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted secret and certificate store for Docker Compose projects, built on BlendSDK v5.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:unit": "pnpm -r test",
    "test:root": "vitest run --config vitest.root.config.ts",
    "test": "pnpm test:unit && pnpm test:root",
    "test:integration": "pnpm --filter @openvault/server test:integration",
    "db:migrate": "pnpm --filter @openvault/server db:migrate",
    "db:types": "pnpm --filter @openvault/server db:types",
    "db:types:check": "pnpm --filter @openvault/server db:types:check",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:react": "node scripts/check-single-react.mjs",
    "check:compose": "node scripts/check-compose.mjs --self-test",
    "security:evidence": "node scripts/security-evidence.mjs --write",
    "security:evidence:check": "node scripts/security-evidence.mjs",
    "security:claims": "node scripts/security-claims.mjs --write",
    "security:claims:check": "node scripts/security-claims.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "audit:full": "pnpm audit --audit-level=high",
    "verify": "pnpm build && pnpm typecheck && pnpm api:check && pnpm lint && pnpm test && pnpm check:artifacts && pnpm check:react && pnpm check:compose && pnpm security:evidence:check && pnpm security:claims:check && pnpm security:release-gate && pnpm docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "pnpm docs:build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "api:generate": "pnpm --filter @openvault/server api:generate",
    "api:check": "pnpm --filter @openvault/server api:check",
    "security:release-gate": "node scripts/check-release-gate.mjs --self-test --mode alpha --version v0.0.0-alpha",
    "ncu": "ncu -u --workspaces -x \"@openvault*\" -x \"pino\" -x \"pino-http\" -x \"react-router\" -x \"@types/node\" && rm -fR node_modules pnpm-lock.yaml && pnpm install && pnpm verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "npm-check-updates": "23.1.1",
    "typescript": "7.0.2",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
