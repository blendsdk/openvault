{
  "name": "openvault",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted secret and certificate store for Docker Compose projects, built on BlendSDK v5.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:unit": "pnpm -r test",
    "test:root": "vitest run --config vitest.root.config.ts",
    "test": "pnpm test:unit && pnpm test:root",
    "test:integration": "pnpm --filter @openvault/server test:integration",
    "db:migrate": "pnpm --filter @openvault/server db:migrate",
    "check:react": "node scripts/check-single-react.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm check:react && pnpm docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "pnpm docs:build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.15.0",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.5"
  }
}
