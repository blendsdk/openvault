[Unit]
Description=OpenVault encrypted backup
Documentation=https://github.com/blendsdk/openvault/blob/main/docs/guide/backup-restore.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openvault
Group=openvault
EnvironmentFile=/etc/openvault/backup.env
ExecStart=/bin/sh -c 'umask 077; mkdir -p /var/backups/openvault; exec /usr/local/bin/ov backup --out "/var/backups/openvault/openvault-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).age"'
# Copy the archive and checkpoint files off the host after every successful backup.
ExecStartPost=/bin/sh -c 'if [ -n "$OPENVAULT_OFFBOX_TARGET" ]; then rsync -a --delete /var/backups/openvault/ "$OPENVAULT_OFFBOX_TARGET"/; fi'
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/openvault

[Install]
WantedBy=multi-user.target
