{
  "name": "@openvault/cli",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ov": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@openvault/api-contract": "workspace:*",
    "@openvault/server": "workspace:*",
    "blendsdk": "5.68.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@peculiar/x509": "3.1.0"
  }
}
