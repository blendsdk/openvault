{
  "name": "@openvault/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node dist/db/cli.js",
    "db:types": "tsx scripts/generate-db-types.ts",
    "db:types:check": "tsx scripts/generate-db-types.ts && git diff --exit-code -- src/database/generated-types.ts src/database/ctypes.ts",
    "audit:prune": "node dist/audit/cli.js",
    "audit:checkpoint": "node dist/audit/checkpoint-cli.js",
    "api:generate": "tsx scripts/api-contract.ts generate",
    "api:check": "tsx scripts/api-contract.ts check"
  },
  "dependencies": {
    "@openvault/api-contract": "workspace:*",
    "@openvault/core": "workspace:*",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/x509": "3.1.0",
    "age-encryption": "0.3.1",
    "blendsdk": "5.68.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "yesql": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openvault/test-support": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./init": {
      "types": "./dist/init/index.d.ts",
      "import": "./dist/init/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    }
  }
}
